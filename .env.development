# ─── NahSehat Dashboard — Development ───
VITE_APP_NAME=NahSehat Dashboard
VITE_ENV=development

# Local backend API (CMS: auth, users, roles, permissions, payors, settings)
VITE_BE_API=/api/v1

# NahSehat API v3 (indemnity, manage care data — external service)
VITE_NAHSEHAT_API_V3=https://repi-api-336781009919.asia-southeast2.run.app/api/v3

# NahSehat AdBrief API v3 (daily monitoring — adbrief service)
VITE_NAHSEHAT_ADBRIEF_API_V3=https://repi2-server-dev-336781009919.asia-southeast2.run.app/adbrief/nahsehat/api/v3

VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=true