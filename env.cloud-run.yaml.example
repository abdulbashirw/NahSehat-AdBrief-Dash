# ─────────────────────────────────────────────────────────────────────
# env.cloud-run.yaml.example — TEMPLATE ONLY (safe to commit)
#
# Copy to env.cloud-run.yaml and fill with REAL values:
#   cp env.cloud-run.yaml.example env.cloud-run.yaml
#
# env.cloud-run.yaml is git-ignored (*.cloud-run.yaml) — NEVER commit it.
# It is consumed by deploy-all.sh via: gcloud run deploy --env-vars-file
# ─────────────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV: production

# ── Database (MySQL / Cloud SQL) ──
DB_HOST: <cloudsql-host-or-ip>
DB_PORT: "3306"
DB_NAME: <database-name>
DB_USER: <db-user>
DB_PASSWORD: <db-password>
DB_SSL: "true"
DB_TLS_MIN_VERSION: TLSv1.2
DB_TLS_MAX_VERSION: TLSv1.3
DB_TLS_CIPHERS: <cipher-list>

# ── Auth ──
# Generate: openssl rand -hex 48
JWT_SECRET: <jwt-secret>
JWT_EXPIRES_IN: 12h

# ── 2FA (TOTP) ──
# Generate: openssl rand -hex 32
# NOTE: rotating this invalidates existing TOTP enrollments unless
# secrets are re-encrypted with the new key (users must re-enroll 2FA).
TWO_FACTOR_ENCRYPTION_KEY: <2fa-encryption-key>

# ── CORS ──
# Comma-separated list of allowed origins (include the frontend URL)
CORS_ORIGIN: <https://frontend-url>
CORS_ALLOW_CLOUD_RUN: "true"

# ── NahSehat API v3 proxy (P1c) — REQUIRED ──
# The CMS server forwards whitelisted external endpoints on behalf of
# authenticated users. If missing/empty, the proxy endpoints
# (indemnity/AdmDailyClaim, managecare/dailyMonitoring) return 503.
# Base URL WITHOUT trailing slash, e.g. https://api.example.com
NAHSEHAT_API_V3_BASE_URL: <nahsehat-api-v3-base-url>
# Optional upstream timeout in ms (default 30000)
NAHSEHAT_API_V3_TIMEOUT_MS: "30000"