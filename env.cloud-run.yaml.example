# ─── NahSehat Dashboard Backend — Cloud Run Environment Variables ───
#
# Copy this file to env.cloud-run.yaml and fill in your values:
#   cp env.cloud-run.yaml.example env.cloud-run.yaml
#
# This file is used by deploy-all.sh:
#   gcloud run deploy ... --env-vars-file env.cloud-run.yaml
#
# ⚠️  This file contains secrets — it is gitignored. Do NOT commit it.

# ─── MySQL Database ──────────────────────────────────
# Option A: Cloud SQL via TCP (with VPC connector)
#   Set DB_HOST to the Cloud SQL private IP (e.g. 10.x.x.x)
# Option B: Cloud SQL via Unix socket
#   Comment out DB_HOST/DB_PORT, uncomment DB_SOCKET_PATH
# Option C: External MySQL with public IP
#   Set DB_HOST to the public IP, no VPC connector needed

DB_HOST: '10.0.0.1'
DB_PORT: '3306'
DB_USER: 'nahsehat_user'
DB_PASSWORD: 'REPLACE_WITH_SECURE_PASSWORD'
DB_NAME: 'nahsehat_analytics_dash'

# For Cloud SQL Unix socket, uncomment and set:
# DB_SOCKET_PATH: '/cloudsql/PROJECT_ID:asia-southeast2:INSTANCE_ID'

# ─── JWT Authentication ──────────────────────────────
JWT_SECRET: 'REPLACE_WITH_SECURE_RANDOM_STRING'
JWT_EXPIRES_IN: '24h'

# ─── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins.
# After the frontend deploys, update this with the frontend Cloud Run URL.
# Example: 'https://adbriefai-frontend-xxxx.run.app,http://localhost:5173'
CORS_ORIGIN: 'https://adbriefai-frontend-xxxx.run.app'

# ─── Server Port ──────────────────────────────────────
# Cloud Run sets PORT automatically. Included for clarity.
PORT: '8080'