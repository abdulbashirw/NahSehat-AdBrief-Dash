# ─── NahSehat Dashboard — Production ───
# These are FALLBACK defaults. When deploying via deploy-all.sh, the actual
# values are injected via Docker build args → .env.production.local (which
# overrides this file). So these defaults only apply for plain `npm run build`
# without build args (e.g. docker-compose with nginx reverse proxy).
VITE_APP_NAME=NahSehat Dashboard
VITE_ENV=production
# Backend CMS API — must include /api/v1 suffix (matches backend route prefix)
VITE_BE_API=/api/v1
# External NahSeHat APIs — full URLs (not proxied by nginx in Cloud Run)
VITE_NAHSEHAT_API_V3=https://repi-api-336781009919.asia-southeast2.run.app/api/v3
VITE_NAHSEHAT_ADBRIEF_API_V3=https://repi2-server-dev-336781009919.asia-southeast2.run.app/adbrief/nahsehat/api/v3
VITE_ENABLE_DEVTOOLS=false