# ─── NahSehat Dashboard — Environment Variables ───
# Copy this to .env.local for development

# Application
VITE_APP_NAME=NahSehat Dashboard
VITE_ENV=development

# API Endpoints
VITE_BE_API=https://adhub.nahsehat.id/api/v1
VITE_NAHSEHAT_API_V3=https://adhub.nahsehat.id/api/v3

# Feature Flags
VITE_ENABLE_DEVTOOLS=true

# ─── Server-side (server/.env) ───
# AdBrief check-member service (gerbang upload data member — Fase 0/1).
# Base URL TANPA trailing slash; endpoint /check-member ditambahkan otomatis.
# Kosong → fitur balik 503 (fail-closed), server tetap jalan.
ADSCORE_CHECK_MEMBER_BASE_URL=https://repi2-server-dev-336781009919.asia-southeast2.run.app/adbrief/api
ADSCORE_CHECK_MEMBER_TIMEOUT_MS=30000