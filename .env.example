# ─── NahSehat Dashboard — Environment Variables ───
# Copy this to .env.local for development

# Application
VITE_APP_NAME=NahSehat Dashboard
VITE_ENV=development

# API Endpoints
VITE_BE_API=https://adhub.nahsehat.id/api/v1
VITE_NAHSEHAT_API_V3=https://adhub.nahsehat.id/api/v3
VITE_NAHSEHAT_ADBRIEF_API_V3=https://adhub.nahsehat.id/adbrief/nahsehat/api/v3

# Feature Flags
VITE_ENABLE_DEVTOOLS=true