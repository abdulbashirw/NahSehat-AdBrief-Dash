# ─────────────────────────────────────────────────────────────────────
# server/.env.example — TEMPLATE ONLY (safe to commit)
#
# Copy to server/.env and fill with REAL values.
# server/.env is git-ignored — NEVER commit it.
# Secrets belong in Cloud Run env vars / Secret Manager in production.
# ─────────────────────────────────────────────────────────────────────

# ── Server ──
PORT=3001
NODE_ENV=development

# ── Database (MySQL / Cloud SQL) ──
# Use DB_SOCKET_PATH for Cloud SQL Unix socket, OR DB_HOST+DB_PORT for TCP.
DB_HOST=
DB_PORT=3306
DB_SOCKET_PATH=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Auth ──
# Generate: openssl rand -hex 48
JWT_SECRET=
# e.g. 12h
JWT_EXPIRES_IN=

# ── 2FA (TOTP) ──
# Generate: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ORIGIN=
# Allow all *.run.app origins (Cloud Run preview URLs)
CORS_ALLOW_CLOUD_RUN=

# ── NahSehat API v3 proxy (P1c) ──
# The CMS server forwards whitelisted external endpoints on behalf of
# authenticated users. Leave empty to disable the proxy (endpoints → 503).
# Base URL WITHOUT trailing slash, e.g. https://api.example.com
NAHSEHAT_API_V3_BASE_URL=
# Service token issued for this CMS server — API v3 validates it (P1b).
# Generate: openssl rand -hex 32
NAHSEHAT_API_V3_TOKEN=
# Optional upstream timeout in ms (default 30000)
NAHSEHAT_API_V3_TIMEOUT_MS=