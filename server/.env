# =====================================================
# NahSehat AdBrief Dashboard — CMS Backend API
# =====================================================
# Cara pakai:
#   1. Uncomment SALAH SATU blok DATABASE di bawah
#      (Local XAMPP / GCP Cloud SQL TCP / GCP Cloud SQL Socket)
#   2. Restart server: npm run dev
#   3. config/index.ts akan otomatis memilih mode koneksi:
#        - DB_SOCKET_PATH terisi  -> Unix socket (XAMPP / Cloud Run)
#        - DB_SOCKET_PATH kosong  -> TCP (DB_HOST + DB_PORT)
# =====================================================


# =====================================================
# APPLICATION
# =====================================================
NODE_ENV=development
PORT=3001


# =====================================================
# DATABASE — pilih SALAH SATU blok, uncomment yang dipakai
# =====================================================

# ── (1) LOCAL XAMPP — MySQL via Unix socket ──────────
# XAMPP default: port 3306, user root, password kosong.
# DB_SOCKET_PATH diisi -> koneksi pakai Unix socket.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=nahsehat_analytics_dash
# DB_SOCKET_PATH=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# ── (2) GCP Cloud SQL — TCP (public IP) ──────────────
# Uncomment & isi password Cloud SQL, comment blok (1).
# Pastikan IP pemangkat di-allow di Cloud SQL.
DB_HOST=10.250.16.5
DB_PORT=3306
DB_USER=bashir
DB_PASSWORD=0xEp8duI*iL(kLJ&
DB_NAME=nahsehat_analytics_dash
DB_SOCKET_PATH=

# ── (3) GCP Cloud SQL — Unix socket (Cloud Run) ──────
# Direkomendasikan untuk Cloud Run. DB_HOST/DB_PORT dikosongkan.
# Uncomment & isi, comment blok (1).
# DB_HOST=10.250.16.5
# DB_PORT=3306
# DB_USER=bashir
# DB_PASSWORD=0xEp8duI*iL(kLJ&
# DB_NAME=nahsehat_analytics_dash
# DB_SOCKET_PATH=/cloudsql/PROJECT_ID:asia-southeast2:INSTANCE_ID

# ── (4) Docker (docker-compose MySQL) ────────────────
# Uncomment & isi, comment blok (1).
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=nahsehat
# DB_PASSWORD=nahsehat_pass
# DB_NAME=nahsehat_analytics_dash
# DB_SOCKET_PATH=


# =====================================================
# JWT AUTHENTICATION
# =====================================================
JWT_SECRET=5Sg9Sk4l3RPC0rCdwucMH/SO43+sRpo1xon5wRdW1x71CNJw8i7a52+jtTgwsIvw
JWT_EXPIRES_IN=24h


# =====================================================
# 2FA ENCRYPTION KEY (Optional)
# =====================================================
# Encrypt TOTP secrets at rest (AES-256-GCM).
# If not set, falls back to JWT_SECRET.
# Generate: openssl rand -base64 48
TWO_FACTOR_ENCRYPTION_KEY=+4znlfVZWQszYR8WOGeo+wQKCasskzNQAnKQHq0veEKeyXxPrvOQti+RAMcRkPts


# =====================================================
# CORS
# =====================================================
# Comma-separated list of allowed origins.
# Local dev: Vite dev server (5173/5174) + backend (3001)
# Cloud Run: set to frontend URL in env.cloud-run.yaml
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001
CORS_ALLOW_CLOUD_RUN=true