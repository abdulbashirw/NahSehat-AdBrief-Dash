# =====================================================
# SERVER — LOCAL ENVIRONMENT CONFIGURATION
# =====================================================
# NahSehat AdBrief Dashboard — CMS Backend API
# Generated for XAMPP MySQL local development
# =====================================================


# =====================================================
# APPLICATION
# =====================================================
NODE_ENV=development
PORT=3001


# =====================================================
# DATABASE (XAMPP MySQL)
# =====================================================
# XAMPP default: port 3306, user root, password kosong
DB_HOST=10.250.16.5
DB_PORT=3306
DB_USER=bashir
DB_PASSWORD=0xEp8duI*iL(kLJ&
DB_NAME=nahsehat_analytics_dash

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=nahsehat_analytics_dash

# Unix socket for local XAMPP — comment out for TCP-only.
# Cloud Run / Cloud SQL socket: /cloudsql/PROJECT:REGION:INSTANCE
DB_SOCKET_PATH=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# Docker (if using docker-compose MySQL)
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=nahsehat
# DB_PASSWORD=nahsehat_pass
# DB_SOCKET_PATH=

# GCP Cloud SQL (public IP)
# DB_HOST=34.101.92.103
# DB_PORT=3306
# DB_USER=nahsehat
# DB_PASSWORD=<cloud-sql-password>
# DB_SOCKET_PATH=

# GCP Cloud SQL (private IP via VPC connector)
# DB_HOST=<cloud-sql-private-ip>
# DB_PORT=3306
# DB_USER=nahsehat
# DB_PASSWORD=<cloud-sql-password>
# DB_SOCKET_PATH=

# GCP Cloud SQL (Unix socket — recommended for Cloud Run)
# DB_HOST=
# DB_PORT=
# DB_SOCKET_PATH=/cloudsql/project-digital-admedika:asia-southeast2:nahsehat-db
# DB_USER=nahsehat
# DB_PASSWORD=<cloud-sql-password>


# =====================================================
# JWT AUTHENTICATION
# =====================================================
JWT_SECRET=5Sg9Sk4l3RPC0rCdwucMH/SO43+sRpo1xon5wRdW1x71CNJw8i7a52+jtTgwsIvw
JWT_EXPIRES_IN=24h


# =====================================================
# 2FA ENCRYPTION KEY (Optional)
# =====================================================
# Used to encrypt TOTP secrets at rest (AES-256-GCM).
# If not set, falls back to JWT_SECRET.
# Generate a new one: openssl rand -base64 48
TWO_FACTOR_ENCRYPTION_KEY=+4znlfVZWQszYR8WOGeo+wQKCasskzNQAnKQHq0veEKeyXxPrvOQti+RAMcRkPts


# =====================================================
# CORS
# =====================================================
# Comma-separated list of allowed origins.
# Local dev: Vite dev server (5173/5174) + backend (3001)
# Cloud Run: set to frontend URL in env.cloud-run.yaml
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001